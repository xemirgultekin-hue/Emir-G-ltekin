---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 — Sayfa Bulunamadı">
  <div style="text-align: center; padding: 60px 0;">
    <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: 4rem; margin-bottom: 10px; font-weight: 900;">404</h2>
    <p style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.5rem; font-style: italic; margin-bottom: 25px; color: #555;">Aradığınız Sayfa Bulunamadı</p>
    <p style="font-size: 1.05rem; color: #666; max-width: 450px; margin: 0 auto 30px;">
      Ulaşmaya çalıştığınız sayfa taşınmış, silinmiş veya adresi değişmiş olabilir.
    </p>
    <a href="/" style="display: inline-block; border: 1px solid #1a1a1a; padding: 10px 24px; font-size: 0.85rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;">
      ← Ana Sayfaya Dön
    </a>
  </div>
</Layout>
