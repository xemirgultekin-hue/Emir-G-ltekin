---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.pubDatetime).getTime() - new Date(a.data.pubDatetime).getTime());

const getSlug = (id: string) => id.replace(/\.[^/.]+$/, "");

const heroPost = posts[0];
const otherPosts = posts.slice(1);
---

<Layout title="Emir Gültekin">
  {heroPost && (
    <section class="hero-card">
      <a href={`/posts/${getSlug(heroPost.id)}/`}>
        <div class="hero-tag">Son Yazı / Manşet</div>
        <h2 class="hero-title">{heroPost.data.title}</h2>
        {heroPost.data.description && (
          <p class="hero-desc">{heroPost.data.description}</p>
        )}
        <div class="post-meta">
          {new Date(heroPost.data.pubDatetime).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" })}
        </div>
      </a>
    </section>
  )}

  {otherPosts.length > 0 && (
    <section>
      <h2 class="section-title">Önceki Yazılar & Notlar</h2>
      <div class="archive-grid">
        {otherPosts.map((post) => (
          <article class="archive-item">
            <a href={`/posts/${getSlug(post.id)}/`}>
              <h3>{post.data.title}</h3>
              {post.data.description && (
                <p>{post.data.description}</p>
              )}
              <div class="post-meta">
                {new Date(post.data.pubDatetime).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" })}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}
</Layout>
