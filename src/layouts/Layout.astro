---
import config from "../data/siteConfig.json";

interface Props {
  title?: string;
  description?: string;
}

const { title = config.siteTitle, description = config.siteSubtitle } = Astro.props;
const today = new Date().toLocaleDateString("tr-TR", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const fontMap: Record<string, string> = {
  "Playfair Display": "'Playfair Display', Georgia, serif",
  "Lora": "'Lora', Georgia, serif",
  "Merriweather": "'Merriweather', Georgia, serif",
  "EB Garamond": "'EB Garamond', Georgia, serif",
  "Cinzel": "'Cinzel', Georgia, serif",
  "Inter": "'Inter', -apple-system, sans-serif",
  "Georgia": "Georgia, serif",
};

const headingFontFamily = fontMap[config.headingFont] || "'Playfair Display', Georgia, serif";
const bodyFontFamily = fontMap[config.bodyFont] || "'Lora', Georgia, serif";

let headingMultiplier = 1;
if (config.headingScale === "large") headingMultiplier = 1.15;
if (config.headingScale === "xlarge") headingMultiplier = 1.3;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=EB+Garamond:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;600;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Merriweather:ital,wght@0,400;0,700;1,300&family=Playfair+Display:ital,wght@0,700;0,900;1,400&display=swap" rel="stylesheet">
    <style is:global define:vars={{
      bgColor: config.bgColor || "#fbfaf6",
      textColor: config.textColor || "#1a1a1a",
      headingColor: config.headingColor || "#1a1a1a",
      tagColor: config.tagColor || "#b91c1c",
      bodyFont: bodyFontFamily,
      headingFont: headingFontFamily,
      scale: headingMultiplier
    }}>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background-color: var(--bgColor);
        color: var(--textColor);
        font-family: var(--bodyFont);
        line-height: 1.7;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }
      .container { max-width: 860px; margin: 0 auto; padding: 0 20px; }
      
      .top-bar-wrapper {
        border-bottom: 1px solid rgba(0,0,0,0.12);
        background: var(--bgColor);
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 20px;
        max-width: 860px;
        margin: 0 auto;
        font-size: 0.75rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #666;
      }
      
      .hamburger-btn {
        background: none;
        border: none;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        width: 24px;
        height: 16px;
        padding: 0;
        z-index: 100;
      }
      .hamburger-btn span {
        display: block;
        width: 100%;
        height: 2px;
        background-color: var(--headingColor);
      }

      .side-menu {
        position: fixed;
        top: 0;
        right: -320px;
        width: 300px;
        height: 100vh;
        background-color: #f4efe6;
        box-shadow: -4px 0 20px rgba(0,0,0,0.15);
        z-index: 90;
        transition: right 0.3s ease-in-out;
        padding: 70px 30px 30px;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      .side-menu.open { right: 0; }
      .side-menu h4 {
        font-family: var(--headingFont);
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        border-bottom: 1px solid var(--headingColor);
        padding-bottom: 8px;
        margin-bottom: 10px;
      }
      .side-menu a {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 6px 0;
        border-bottom: 1px dashed rgba(0,0,0,0.15);
      }
      .side-menu a:hover { color: var(--tagColor); }

      .backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.4);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        z-index: 80;
      }
      .backdrop.open { opacity: 1; visibility: visible; }

      .masthead {
        border-bottom: 3px double var(--headingColor);
        padding: 30px 0 20px;
        text-align: center;
      }
      .masthead h1 {
        font-family: var(--headingFont);
        color: var(--headingColor);
        font-size: calc(clamp(2.2rem, 5vw, 3.8rem) * var(--scale));
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 6px;
      }
      .masthead p {
        font-size: 0.95rem;
        font-style: italic;
        color: #555;
      }

      .nav-bar {
        border-bottom: 1px solid var(--headingColor);
        padding: 10px 0;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 600;
      }
      .nav-bar a:hover { text-decoration: underline; color: var(--tagColor); }

      .hero-card {
        border-bottom: 1px solid rgba(0,0,0,0.15);
        padding: 35px 0;
        margin-bottom: 35px;
      }
      .hero-tag {
        color: var(--tagColor);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
      }
      .hero-title {
        font-family: var(--headingFont);
        color: var(--headingColor);
        font-size: calc(clamp(1.8rem, 4vw, 2.5rem) * var(--scale));
        font-weight: 700;
        line-height: 1.25;
        margin-bottom: 12px;
      }
      .hero-title:hover { text-decoration: underline; }
      .hero-desc { font-size: 1.1rem; margin-bottom: 12px; }
      .post-meta { font-size: 0.8rem; color: #777; }

      .archive-item { border-bottom: 1px solid rgba(0,0,0,0.1); padding: 20px 0; }
      .archive-item h3 {
        font-family: var(--headingFont);
        color: var(--headingColor);
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 8px;
      }
      .archive-item h3:hover { text-decoration: underline; }
      .archive-item p { font-size: 0.95rem; color: #444; margin-bottom: 10px; }

      .article-header {
        border-bottom: 1px solid rgba(0,0,0,0.12);
        padding: 30px 0 20px;
        margin-bottom: 30px;
        text-align: center;
      }
      .article-header h1 {
        font-family: var(--headingFont);
        color: var(--headingColor);
        font-size: calc(clamp(2rem, 4.5vw, 2.8rem) * var(--scale));
        line-height: 1.25;
        margin-bottom: 15px;
      }
      .article-body { font-size: 1.15rem; line-height: 1.85; }
      .article-body p { margin-bottom: 24px; }
      .article-body h2, .article-body h3 {
        font-family: var(--headingFont);
        color: var(--headingColor);
        margin: 35px 0 15px;
      }

      .footer {
        border-top: 1px solid rgba(0,0,0,0.12);
        padding: 30px 0 40px;
        text-align: center;
        font-size: 0.8rem;
        color: #777;
        margin-top: 60px;
      }
    </style>
  </head>
  <body>
    <div class="top-bar-wrapper">
      <div class="top-bar">
        <span>{today} — {config.locationTag}</span>
        <button class="hamburger-btn" id="menuToggle" aria-label="Menü Aç">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <div class="backdrop" id="backdrop"></div>
    <nav class="side-menu" id="sideMenu">
      <h4>Menü</h4>
      {(config.navLinks || []).map((item: any) => (
        <a href={item.url} target={item.url.startsWith("http") ? "_blank" : "_self"} rel="noopener">
          {item.label}
        </a>
      ))}
    </nav>

    <header class="masthead container">
      <a href="/">
        <h1>{config.siteTitle}</h1>
      </a>
      <p>{config.siteSubtitle}</p>
    </header>

    <nav class="nav-bar container">
      {(config.navLinks || []).map((item: any) => (
        <a href={item.url} target={item.url.startsWith("http") ? "_blank" : "_self"} rel="noopener">
          {item.label}
        </a>
      ))}
    </nav>

    <main class="container" style="padding-top: 25px;">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <p>© {new Date().getFullYear()} {config.siteTitle}. {config.footerText}</p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById("menuToggle");
      const sideMenu = document.getElementById("sideMenu");
      const backdrop = document.getElementById("backdrop");

      const toggleMenu = () => {
        sideMenu?.classList.toggle("open");
        backdrop?.classList.toggle("open");
      };

      toggle?.addEventListener("click", toggleMenu);
      backdrop?.addEventListener("click", toggleMenu);
    </script>
  </body>
</html>
