---
interface Props {
  title?: string;
  description?: string;
}

const { title = "Emir Gültekin", description = "Kişisel Notlar ve Analizler" } = Astro.props;
const today = new Date().toLocaleDateString("tr-TR", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#fcfbf9] text-[#1a1a1a] antialiased">
    <!-- Üst Bar / Tarih -->
    <header class="border-b border-[#e5e2dc] py-2 px-4 text-xs text-stone-500 uppercase tracking-widest text-center">
      {today} — İstanbul
    </header>

    <!-- Logo / Yazar İmzası -->
    <div class="border-b-2 border-stone-900 py-6 text-center">
      <a href="/" class="text-4xl sm:text-5xl font-black tracking-tight uppercase hover:opacity-90">
        EMİR GÜLTEKİN
      </a>
      <p class="text-xs sm:text-sm text-stone-600 mt-2 font-serif italic">
        Uluslararası İlişkiler, Küresel Strateji ve Kişisel Notlar
      </p>
    </div>

    <!-- Ana İçerik Konteyneri -->
    <main class="max-w-4xl mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Alt Bilgi (Footer) -->
    <footer class="border-t border-[#e5e2dc] mt-16 py-8 text-center text-xs text-stone-500">
      <p>© {new Date().getFullYear()} Emir Gültekin. Tüm hakları saklıdır.</p>
    </footer>

    <style is:global>
      html, body {
        font-family: "Times New Roman", Times, Georgia, serif;
      }
    </style>
  </body>
</html>
