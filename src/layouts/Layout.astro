---
interface Props {
  title?: string;
  description?: string;
  [key: string]: any;
}

const { title = "Emir Gültekin", description = "Kişisel Notlar ve Analizler" } = Astro.props;
const today = new Date().toLocaleDateString("tr-TR", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,700;0,900;1,400&display=swap" rel="stylesheet">
    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        background-color: #fbfaf6;
        color: #1a1a1a;
        font-family: 'Lora', Georgia, serif;
        line-height: 1.7;
        padding-bottom: 40px;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .container {
        max-width: 860px;
        margin: 0 auto;
        padding: 0 20px;
      }
      .top-bar {
        border-bottom: 1px solid #dcd7ce;
        padding: 10px 0;
        text-align: center;
        font-size: 0.75rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #666;
      }
      .masthead {
        border-bottom: 3px double #1a1a1a;
        padding: 35px 0 25px;
        text-align: center;
      }
      .masthead h1 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 6px;
      }
      .masthead p {
        font-size: 0.95rem;
        font-style: italic;
        color: #555;
      }
      .hero-card {
        border-bottom: 1px solid #1a1a1a;
        padding: 40px 0 35px;
        margin-bottom: 35px;
      }
      .hero-tag {
        color: #b91c1c;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
      }
      .hero-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        font-weight: 700;
        line-height: 1.25;
        margin-bottom: 14px;
      }
      .hero-title:hover {
        text-decoration: underline;
      }
      .hero-desc {
        font-size: 1.15rem;
        color: #333;
        margin-bottom: 12px;
      }
      .post-meta {
        font-size: 0.8rem;
        color: #777;
      }
      .section-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.25rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-bottom: 1px solid #dcd7ce;
        padding-bottom: 8px;
        margin-bottom: 25px;
      }
      .archive-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
        margin-bottom: 50px;
      }
      .archive-item {
        border-bottom: 1px solid #e5e0d8;
        padding-bottom: 20px;
      }
      .archive-item h3 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 8px;
      }
      .archive-item h3:hover {
        text-decoration: underline;
      }
      .archive-item p {
        font-size: 0.95rem;
        color: #444;
        margin-bottom: 10px;
      }
      .article-header {
        border-bottom: 1px solid #dcd7ce;
        padding: 35px 0 20px;
        margin-bottom: 30px;
        text-align: center;
      }
      .article-header h1 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(2rem, 4.5vw, 3rem);
        line-height: 1.25;
        margin-bottom: 15px;
      }
      .article-body {
        font-size: 1.15rem;
        line-height: 1.85;
        color: #1a1a1a;
      }
      .article-body p {
        margin-bottom: 24px;
      }
      .article-body h2, .article-body h3 {
        font-family: 'Playfair Display', Georgia, serif;
        margin: 35px 0 15px;
      }
      .article-body blockquote {
        border-left: 3px solid #1a1a1a;
        padding-left: 18px;
        font-style: italic;
        margin: 25px 0;
        color: #444;
      }
      .footer {
        border-top: 1px solid #dcd7ce;
        padding: 30px 0 20px;
        text-align: center;
        font-size: 0.8rem;
        color: #777;
        margin-top: 60px;
      }
    </style>
  </head>
  <body>
    <div class="top-bar">
      {today} — İstanbul
    </div>

    <header class="masthead">
      <div class="container">
        <a href="/">
          <h1>EMİR GÜLTEKİN</h1>
        </a>
        <p>Uluslararası İlişkiler, Küresel Strateji ve Kişisel Notlar</p>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <p>© {new Date().getFullYear()} Emir Gültekin. Tüm hakları saklıdır.</p>
      </div>
    </footer>
  </body>
</html>
